Geometry = xyzFormat {
 <<< "geom.xyz"
}
Driver =  {}
Hamiltonian = DFTB {
  SCC = Yes
  SCCTolerance = 1.0e-7
  MaxSCCIterations = 1000
  Mixer = Broyden {
    MixingParameter = 0.051
    InverseJacobiWeight = 0.01
    MinimalWeight = 1.
    MaximalWeight = 100000.
    WeightFactor = 0.01
  }
  Dispersion = LennardJones {
  Parameters = UFFParameters {}
  }
  SlaterKosterFiles = Type2FileNames {
  Prefix = "/user/home/li23821/Programs/dftb+_params/mio-1-1/"
  Separator = "-"
  Suffix = ".skf"
}
  MaxAngularMomentum {
    H = "s"
    C = "p"
  }
  Charge = 0.0
  Filling = Fermi {
    Temperature [Kelvin] = 0.0
  }
  ReadInitialCharges = No
  Solver = DivideAndConquer {}
  OldSKInterpolation = No
}
 Options = {
  RestartFrequency = 20
  RandomSeed = 0
  WriteAutotestTag = Yes
  WriteDetailedXML = Yes
  WriteResultsTag = Yes
  WriteDetailedOut = Yes
 }
 Analysis = {
   PrintForces = Yes
   MullikenAnalysis = Yes
   CM5 {}
 }
 ParserOptions = {
   WriteHSDInput = Yes
   ParserVersion = 4
 }
